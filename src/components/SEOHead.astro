---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { title, description, canonical, ogImage = '/og-image.jpg', breadcrumbs } = Astro.props;
const siteUrl = 'https://jpmarchant.cl';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : Astro.url.href;

// Person schema (global)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Juan Paulo Marchant Espinoza",
  "givenName": "Juan Paulo",
  "familyName": "Marchant Espinoza",
  "jobTitle": "Investigador en Politicas Publicas y Violencia de Genero",
  "description": "Psicologo, Doctor en Politicas Publicas. Investigador especializado en femicidio, violencia de genero y reparacion a victimas en Chile y America Latina.",
  "url": siteUrl,
  "email": "contacto@jpmarchant.cl",
  "nationality": { "@type": "Country", "name": "Chile" },
  "knowsLanguage": ["es", "en"],
  "sameAs": [
    "https://orcid.org/0000-0001-6651-7086",
    "https://scholar.google.com/citations?user=Tn9IUL8AAAAJ",
    "https://www.linkedin.com/in/juan-paulo-marchant-espinoza-80955733/",
    "https://dialnet.unirioja.es/servlet/autor?codigo=2495974",
    "https://investigadores.anid.cl/es/public_search/researcher?id=32968",
    "https://cedit.cl/somos/juan-paulo-marchant/"
  ],
  "affiliation": [
    { "@type": "Organization", "name": "Universidad Bernardo O'Higgins" },
    { "@type": "Organization", "name": "Universidad Andres Bello" },
    { "@type": "Organization", "name": "Universidad Gabriela Mistral" },
    { "@type": "Organization", "name": "CEDIT - Nucleo Milenio" }
  ],
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "Universidad Mayor" },
    { "@type": "CollegeOrUniversity", "name": "Universidad de Chile" }
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "degree",
      "name": "Doctor en Politicas Publicas"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "degree",
      "name": "Magister en Estudios de Genero y Cultura, mencion Humanidades"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "degree",
      "name": "Psicologo"
    }
  ],
  "knowsAbout": [
    "Femicidio",
    "Violencia de genero",
    "Politicas publicas",
    "Reparacion a victimas",
    "Represion politica",
    "Estudios de genero"
  ]
};

// WebSite schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Juan Paulo Marchant Espinoza - Investigador",
  "url": siteUrl,
  "author": { "@id": `${siteUrl}/#person` },
  "inLanguage": "es",
  "description": "Sitio academico de Juan Paulo Marchant Espinoza. Investigacion sobre femicidio, violencia de genero, politicas publicas y reparacion a victimas en Chile."
};

// BreadcrumbList schema (dynamic)
const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
    ...breadcrumbs.map((bc, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": bc.name,
      "item": `${siteUrl}${bc.url}`
    }))
  ]
} : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={fullCanonical} />
<meta name="author" content="Juan Paulo Marchant Espinoza" />
<meta name="robots" content="index, follow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:image" content={`${siteUrl}${ogImage}`} />
<meta property="og:locale" content="es_CL" />
<meta property="og:site_name" content="Juan Paulo Marchant Espinoza" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

<!-- JSON-LD: Person -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<!-- JSON-LD: WebSite -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<!-- JSON-LD: BreadcrumbList -->
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-ELCQXC3N20"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-ELCQXC3N20');
</script>

<!-- LLMs discovery -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Summary" />
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM Full Profile" />

<!-- Preload fonts -->
<link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
