---
const year = new Date().getFullYear();
---

<footer class="relative bg-primary-900 text-white overflow-hidden noise">
  <div class="gradient-blur w-[300px] h-[300px] bg-accent-500 -bottom-20 right-10 absolute"></div>

  <div class="relative max-w-6xl mx-auto px-4 md:px-8 pt-16 pb-8">
    <div class="grid md:grid-cols-3 gap-10 mb-12">
      <!-- Brand -->
      <div>
        <p class="font-serif font-bold text-xl mb-3">Dr. Juan Paulo Marchant Espinoza</p>
        <p class="text-neutral-400 text-sm leading-relaxed max-w-xs">
          Investigador en violencia de genero, femicidio y politicas publicas. Conectando evidencia cientifica con transformacion social.
        </p>
        <a href="mailto:contacto@jpmarchant.cl" class="inline-block mt-4 text-sm text-primary-300 hover:text-white no-underline transition-colors">
          contacto@jpmarchant.cl
        </a>
      </div>

      <!-- Links -->
      <div>
        <p class="font-semibold text-xs uppercase tracking-[0.15em] text-neutral-500 mb-4">Navegacion</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/publicaciones/" class="text-neutral-400 hover:text-white no-underline transition-colors duration-300">Publicaciones</a></li>
          <li><a href="/investigacion/" class="text-neutral-400 hover:text-white no-underline transition-colors duration-300">Investigacion</a></li>
          <li><a href="/docencia/" class="text-neutral-400 hover:text-white no-underline transition-colors duration-300">Docencia</a></li>
          <li><a href="/trayectoria/" class="text-neutral-400 hover:text-white no-underline transition-colors duration-300">Trayectoria</a></li>
          <li><a href="/prensa/" class="text-neutral-400 hover:text-white no-underline transition-colors duration-300">Prensa</a></li>
          <li><a href="/contacto/" class="text-neutral-400 hover:text-white no-underline transition-colors duration-300">Contacto</a></li>
        </ul>
      </div>

      <!-- Academic profiles -->
