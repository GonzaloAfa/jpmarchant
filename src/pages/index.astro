---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import personal from '../data/personal.json';
import publications from '../data/publications.json';

const featured = publications.filter(p => p.featured).sort((a, b) => b.year - a.year);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quien es Juan Paulo Marchant Espinoza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Juan Paulo Marchant Espinoza es un investigador chileno, psicologo de la Universidad de Chile y Doctor en Politicas Publicas por la Universidad Mayor (2025). Se especializa en femicidio, violencia de genero y politicas publicas. Fue Coordinador Nacional de Casas de Acogida en SernamEG entre 2012 y 2018. Actualmente es academico en la Universidad Bernardo O'Higgins, profesor en la Universidad Andres Bello y la Universidad Gabriela Mistral, e investigador en el CEDIT Nucleo Milenio."
      }
    },
    {
      "@type": "Question",
      "name": "Cual es la especialidad de investigacion de Juan Paulo Marchant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Su investigacion se centra en femicidio y analisis territorial en Chile, violencia de genero y reparacion a victimas, memoria y represion politica, y desastres naturales y trauma psicosocial. Tiene 19 publicaciones academicas en revistas internacionales como Applied Spatial Analysis and Policy (Springer) y Onati Socio-Legal Series."
      }
    },
    {
      "@type": "Question",
      "name": "Donde trabaja actualmente Juan Paulo Marchant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Es academico en la Universidad Bernardo O'Higgins, Profesor Asistente Adjunto en la Universidad Andres Bello (UNAB), profesor en la Universidad Gabriela Mistral, e Investigador Joven en el CEDIT Nucleo Milenio. Tambien dirige Centro Humain Ltda desde 2014."
      }
    },
    {
      "@type": "Question",
      "name": "Que experiencia tiene Juan Paulo Marchant en politica publica?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fue Coordinador Nacional de Casas de Acogida y Centros de la Mujer en el Servicio Nacional de la Mujer y Equidad de Genero (SernamEG) de Chile entre 2012 y 2018. Durante seis anos coordino los dispositivos de proteccion para mujeres victimas de violencia a nivel nacional."
      }
    }
  ]
};

const stats = [
  { number: '17+', label: 'Publicaciones academicas' },
  { number: '6', label: 'Paises de alcance' },
  { number: '2', label: 'Libros publicados' },
  { number: '6', label: 'Anos en politica publica' },
  { number: '3', label: 'Universidades actuales' },
];

const researchAreas = [
  {
    title: 'Femicidio y territorio',
    description: 'Investigacion sobre como el Estado puede y debe prevenir la violencia contra las mujeres. Desde el analisis territorial de femicidios hasta la evaluacion de medidas cautelares.',
    gradient: 'from-primary-500 to-primary-700',
    number: '01',
  },
  {
    title: 'Genero, violencia y reparacion',
    description: 'Trabajo directo con victimas de violencia de genero y desarrollo de modelos de reparacion psicosocial. Seis anos coordinando casas de acogida a nivel nacional.',
    gradient: 'from-accent-500 to-accent-700',
    number: '02',
  },
  {
    title: 'Memoria, represion y poder',
    description: 'Investigacion sobre las heridas de la dictadura, la represion del lenguaje y las formas contemporaneas de violencia institucional en Chile.',
    gradient: 'from-primary-700 to-primary-900',
    number: '03',
  },
];
---

<BaseLayout
  title="Dr. Juan Paulo Marchant Espinoza | Investigador en violencia de genero y politicas publicas"
  description="Investigador chileno especializado en femicidio, violencia de genero y politicas publicas. Doctor en Politicas Publicas. Mas de 17 publicaciones academicas."
  canonical="/"
>
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center bg-primary-900 text-white overflow-hidden noise">
    <!-- Gradient blobs -->
    <div class="gradient-blur w-[500px] h-[500px] bg-primary-300 -top-40 -right-40 absolute"></div>
    <div class="gradient-blur w-[400px] h-[400px] bg-accent-500 bottom-0 left-1/4 absolute"></div>
    <div class="gradient-blur w-[300px] h-[300px] bg-primary-200 top-1/3 -left-20 absolute"></div>

    <!-- Dot pattern subtle -->
    <div class="absolute inset-0 dot-pattern opacity-[0.03]"></div>

    <div class="relative max-w-6xl mx-auto px-4 md:px-8 py-24 md:py-32 w-full">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-sm border border-white/10 mb-8">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-sm text-neutral-300">Doctor en Politicas Publicas &middot; Universidad Mayor, 2025</span>
        </div>

        <h1 class="font-serif text-4xl md:text-5xl lg:text-[3.5rem] font-bold leading-[1.1] mb-8">
          <span class="gradient-text">{personal.tagline}</span>
        </h1>

        <p class="text-lg md:text-xl text-neutral-300 leading-relaxed mb-6 max-w-2xl">
          <span class="font-semibold text-white">{personal.name}</span> &mdash; Psicologo, investigador y academico chileno especializado en femicidio, violencia de genero y reparacion a victimas.
        </p>

        <blockquote class="relative pl-6 mb-10">
          <div class="absolute left-0 top-0 bottom-0 w-[3px] rounded-full bg-gradient-to-b from-accent-500 to-primary-500"></div>
          <p class="text-neutral-300 italic text-lg">&ldquo;{personal.quote}&rdquo;</p>
        </blockquote>

        <div class="flex flex-wrap gap-4">
          <a href="/publicaciones" class="group px-7 py-3.5 bg-white text-primary-900 font-semibold rounded-lg hover:bg-neutral-100 transition-all duration-300 no-underline inline-flex items-center gap-2">
            Ver publicaciones
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="/contacto" class="px-7 py-3.5 border border-white/20 text-white font-semibold rounded-lg hover:bg-white/10 hover:border-white/40 transition-all duration-300 no-underline backdrop-blur-sm">
            Contacto y colaboracion
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-60">
      <span class="text-xs tracking-widest uppercase text-neutral-400">Scroll</span>
      <div class="w-5 h-8 rounded-full border-2 border-neutral-400 flex justify-center pt-1.5">
        <div class="w-1 h-2 rounded-full bg-neutral-400 animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="relative -mt-12 z-10">
    <div class="max-w-5xl mx-auto px-4 md:px-8">
      <div class="bg-white rounded-2xl shadow-xl border border-neutral-100 p-8 md:p-10 reveal-scale">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-center stagger-children">
          {stats.map(stat => (
            <div>
              <p class="text-3xl md:text-4xl font-bold text-primary-500 font-serif">{stat.number}</p>
              <p class="text-xs md:text-sm text-neutral-500 mt-1.5 leading-tight">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Areas -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 py-24 md:py-32">
    <div class="reveal">
      <div class="section-divider mb-6"></div>
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 mb-3">Lineas de investigacion</h2>
      <p class="text-neutral-500 mb-14 max-w-2xl text-lg">Mas de 15 anos conectando la investigacion academica con la transformacion de politicas publicas.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 stagger-children">
      {researchAreas.map(area => (
        <div class="group relative bg-white rounded-2xl border border-neutral-200 overflow-hidden card-hover">
          <div class={`h-1.5 bg-gradient-to-r ${area.gradient}`}></div>
          <div class="p-7">
            <span class="text-5xl font-serif font-bold text-neutral-100 block mb-2">{area.number}</span>
            <h3 class="font-semibold text-xl text-neutral-900 mb-3">{area.title}</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">{area.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center reveal">
      <a href="/investigacion" class="group inline-flex items-center gap-2 text-primary-500 font-medium hover:text-primary-700 no-underline transition-colors">
        Explorar investigacion
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>
  </section>

  <!-- Visual break: Quote -->
  <section class="relative bg-primary-900 text-white py-20 md:py-28 overflow-hidden noise">
    <div class="gradient-blur w-[400px] h-[400px] bg-accent-500 top-0 right-0 absolute"></div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-8 text-center reveal">
      <svg class="w-12 h-12 text-primary-300 mx-auto mb-6 opacity-40" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
      <blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl font-medium leading-snug mb-6">
        Investigar la violencia no es solo documentarla, es construir las herramientas para transformar las politicas que protegen vidas.
      </blockquote>
      <p class="text-neutral-400">&mdash; Dr. Juan Paulo Marchant Espinoza</p>
    </div>
  </section>

  <!-- Featured Publications -->
  <section class="py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div class="reveal">
        <div class="section-divider mb-6"></div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 mb-3">Publicaciones destacadas</h2>
        <p class="text-neutral-500 mb-14 max-w-2xl text-lg">Investigacion reciente publicada en revistas internacionales indexadas.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 stagger-children">
        {featured.map(pub => (
          <div class="card-hover h-full">
            <PublicationCard
              id={pub.id}
              title={pub.title}
              authors={pub.authors}
              year={pub.year}
              type={pub.type}
              journal={pub.journal}
              volume={pub.volume}
              pages={pub.pages}
              doi={pub.doi}
              isbn={pub.isbn}
              url={pub.url}
              tags={pub.tags}
            />
          </div>
        ))}
      </div>

      <div class="mt-10 text-center reveal">
        <a href="/publicaciones" class="group inline-flex items-center gap-2 text-primary-500 font-medium hover:text-primary-700 no-underline transition-colors">
          Ver todas las publicaciones
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Visual break: Dot pattern band -->
  <div class="h-px bg-gradient-to-r from-transparent via-neutral-300 to-transparent"></div>

  <!-- Affiliations -->
  <section class="py-24 md:py-32 relative">
    <div class="absolute inset-0 dot-pattern opacity-[0.025]"></div>
    <div class="relative max-w-6xl mx-auto px-4 md:px-8">
      <div class="reveal">
        <div class="section-divider mb-6"></div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 mb-3">Afiliaciones actuales</h2>
        <p class="text-neutral-500 mb-14 max-w-2xl text-lg">Actividad academica e investigativa en multiples instituciones.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-children">
        {personal.affiliations.map((aff, i) => (
          <div class="bg-white rounded-2xl border border-neutral-200 p-6 card-hover relative overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-bl from-primary-50 to-transparent rounded-bl-full"></div>
            <div class="relative">
              <span class="text-4xl font-serif font-bold text-neutral-100">{String(i + 1).padStart(2, '0')}</span>
              <p class="font-semibold text-neutral-900 text-lg mt-1">{aff.institution}</p>
              <p class="text-sm text-neutral-500 mt-1">{aff.role}</p>
              <p class="text-xs text-neutral-400 mt-3 font-mono">{aff.period}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-gradient-to-br from-primary-500 via-primary-600 to-primary-700 text-white overflow-hidden noise">
    <div class="gradient-blur w-[400px] h-[400px] bg-accent-500 -bottom-20 -right-20 absolute"></div>
    <div class="relative max-w-6xl mx-auto px-4 md:px-8 py-20 md:py-28 text-center reveal">
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-5">Colaboremos</h2>
      <p class="text-primary-100 max-w-xl mx-auto mb-10 text-lg">Abierto a colaboraciones de investigacion, invitaciones a conferencias y consultoria en politicas publicas de genero.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contacto" class="group px-8 py-3.5 bg-white text-primary-900 font-semibold rounded-lg hover:bg-neutral-100 transition-all duration-300 no-underline inline-flex items-center gap-2">
          Contactar
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
        <a href="mailto:contacto@jpmarchant.cl" class="px-8 py-3.5 border border-white/20 text-white font-semibold rounded-lg hover:bg-white/10 hover:border-white/40 transition-all duration-300 no-underline backdrop-blur-sm">
          contacto@jpmarchant.cl
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Schema for AI/GEO -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
