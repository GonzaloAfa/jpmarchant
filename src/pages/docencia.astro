---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentInstitutions = [
  {
    institution: "Universidad Bernardo O'Higgins",
    role: 'Academico, Facultad de Ciencias Humanas',
    period: '2025 - presente',
    description: 'Docencia e investigacion en la Facultad de Ciencias Humanas, con enfasis en genero, violencia y politicas publicas.',
  },
  {
    institution: 'Universidad Andres Bello',
    role: 'Profesor Asistente Adjunto, Escuela de Psicologia',
    period: '2019 - presente',
    description: 'Docencia de pregrado y posgrado en psicologia, con enfoque en violencia de genero, intervencion psicosocial y politicas publicas.',
  },
  {
    institution: 'Universidad Gabriela Mistral',
    role: 'Profesor adjunto, Psicologia Advance',
    period: '2025 - presente',
    description: 'Docencia en programas de psicologia con orientacion profesional avanzada.',
  },
];

const previousInstitutions = [
  { institution: 'Universidad de Talca', role: 'Profesor', period: 'Anterior' },
  { institution: 'Universidad Mayor', role: 'Profesor', period: 'Anterior' },
  { institution: 'ICEL Metro', role: 'Docente', period: 'Anterior' },
  { institution: 'Universidad de Chile', role: 'Docente', period: 'Anterior' },
];

const thesisAreas = [
  'Femicidio y violencia de genero',
  'Politicas publicas con perspectiva de genero',
  'Reparacion psicosocial a victimas',
  'Memoria y derechos humanos',
  'Masculinidades y genero',
  'Intervencion en crisis y desastres',
];
---

<BaseLayout
  title="Docencia | Dr. Juan Paulo Marchant Espinoza"
  description="Actividad docente del Dr. Juan Paulo Marchant Espinoza en universidades chilenas. Profesor de psicologia, genero y politicas publicas."
>
  <!-- Hero -->
  <section class="relative bg-primary-900 text-white noise overflow-hidden">
    <div class="gradient-blur w-80 h-80 bg-accent-500 -top-24 -right-24"></div>
    <div class="gradient-blur w-96 h-96 bg-primary-300 -bottom-40 -left-40"></div>

    <div class="relative max-w-6xl mx-auto px-4 md:px-8 py-24 md:py-32">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-sm border border-white/10 mb-8">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        <span class="text-sm text-neutral-300">Docencia</span>
      </div>
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-6">Actividad docente</h1>
      <p class="text-neutral-300 max-w-2xl leading-relaxed text-lg">Formando profesionales comprometidos con la justicia social, la perspectiva de genero y la transformacion de politicas publicas.</p>
    </div>
  </section>

  <!-- Award -->
  <section class="bg-accent-500/5 border-b border-accent-500/10">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-8">
      <div class="reveal flex items-center gap-4">
        <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-accent-500/10 flex items-center justify-center">
          <span class="text-accent-500 text-2xl">&#9733;</span>
        </div>
        <div>
          <p class="font-semibold text-neutral-900 text-lg">Docente Inspira UNAB 2025</p>
          <p class="text-sm text-neutral-500">Reconocimiento otorgado por la Universidad Andres Bello a la excelencia en docencia e inspiracion estudiantil.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Institutions -->
  <section class="py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div class="reveal">
        <div class="section-divider mb-6"></div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 mb-3">Instituciones actuales</h2>
        <p class="text-neutral-500 mb-12 max-w-2xl">Actividad docente e investigativa en tres universidades chilenas.</p>
      </div>

      <div class="grid gap-6 stagger-children">
        {currentInstitutions.map(inst => (
          <div class="card-hover bg-white border border-neutral-200 rounded-2xl overflow-hidden">
            <div class="h-1.5 bg-gradient-to-r from-primary-500 to-accent-500"></div>
            <div class="p-6 md:p-8">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <h3 class="font-semibold text-lg text-neutral-900">{inst.institution}</h3>
                <span class="text-xs px-2.5 py-0.5 rounded-full bg-green-50 text-green-700 font-medium border border-green-200">Activo</span>
              </div>
              <p class="text-sm text-primary-500 font-medium mb-2">{inst.role}</p>
              <p class="text-sm text-neutral-600 leading-relaxed mb-3">{inst.description}</p>
              <p class="font-mono text-xs text-neutral-400">{inst.period}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="h-px bg-gradient-to-r from-transparent via-neutral-300 to-transparent"></div>

  <!-- Previous Institutions -->
  <section class="bg-neutral-100 border-y border-neutral-200 py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div class="reveal">
        <div class="section-divider mb-6"></div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 mb-3">Docencia anterior</h2>
        <p class="text-neutral-500 mb-12 max-w-2xl">Instituciones donde ha ejercido docencia previamente.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 stagger-children">
        {previousInstitutions.map(inst => (
          <div class="card-hover bg-white border border-neutral-200 rounded-2xl p-6">
            <p class="font-semibold text-neutral-900">{inst.institution}</p>
            <p class="text-sm text-neutral-500 mt-1">{inst.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="h-px bg-gradient-to-r from-transparent via-neutral-300 to-transparent"></div>

  <!-- Thesis Supervision -->
  <section class="py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div class="reveal">
        <div class="section-divider mb-6"></div>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 mb-3">Supervision de tesis</h2>
        <p class="text-neutral-500 mb-12 max-w-2xl">Guia de tesis de pregrado y posgrado en las siguientes areas tematicas.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 stagger-children">
        {thesisAreas.map(area => (
          <div class="card-hover bg-white border border-neutral-200 rounded-2xl p-6 flex items-start gap-3">
            <span class="flex-shrink-0 w-2.5 h-2.5 rounded-full bg-gradient-to-br from-accent-500 to-primary-500 mt-1.5"></span>
            <p class="text-sm text-neutral-700">{area}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center reveal">
        <a href="/contacto" class="group inline-flex items-center gap-2 px-8 py-3 bg-primary-500 text-white font-semibold rounded-lg hover:bg-primary-700 transition-all duration-300 no-underline">
          Consultar por supervision de tesis
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
